 # ============================================================
# perceive-decide-act — environment variables
# ============================================================
# Place this file at the repo root as .env  (same directory
# as llm_gatewayV3/).  The gateway reads ../.env relative to
# its own directory, so a single file serves both the gateway
# and the agent.
#
# Copy and fill in:
#   cp .env.example .env
# ============================================================


# ------------------------------------------------------------
# Gateway port
# agent hard-codes http://localhost:8101 — change here if
# you run the gateway on a different port.
# ------------------------------------------------------------
GATEWAY_V3_PORT=8101


# ------------------------------------------------------------
# Worker provider keys
# At least one key is required; the gateway skips providers
# whose key is missing.
# ------------------------------------------------------------

# Google Gemini — free tier: 15 RPM / 1,000 RPD
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

# NVIDIA NIM — free tier: 40 RPM
# https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_MODEL=deepseek-ai/deepseek-v3.2

# Groq — free tier: 30 RPM / 1,000 RPD
# https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Cerebras — free tier: 30 RPM / 1M tokens per day (8K ctx cap)
# ⚠  llama3.1-8b router model deprecates May 27 2026 — see ROUTER_CEREBRAS_MODEL below
# https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_MODEL=zai-glm-4.7

# OpenRouter — free `:free` models: 20 RPM / 50 RPD
# https://openrouter.ai/keys
OPEN_ROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# GitHub Models — 10–15 RPM / 50–150 RPD, 8K input / 4K output cap
# https://github.com/settings/tokens  (needs models:read scope)
GITHUB_ACCESS_TOKEN=your_github_pat_here
GITHUB_MODEL=openai/gpt-4.1-mini

# Ollama (local) — unlimited; only loaded when OLLAMA_MODEL is set
OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:31b   # uncomment to enable Ollama


# ------------------------------------------------------------
# Worker failover order
# Comma-separated list of provider shortnames.  The gateway
# tries them left-to-right, skipping rate-limited ones.
# Remove a provider here (or leave its key blank) to exclude it.
# ------------------------------------------------------------
LLM_ORDER=ollama,gemini,nvidia,groq,cerebras,openrouter,github


# ------------------------------------------------------------
# V3 router pool
# These four small/fast LLMs classify each request as
# TINY / LARGE / HUGE and select the worker tier.
# Any provider whose *_API_KEY is missing is silently skipped.
# If all four are missing, routing falls back to a simple
# token-count rule — the worker call still succeeds.
# ------------------------------------------------------------
ROUTER_ORDER=cerebras,groq,nvidia,github

# ⚠  Deprecates May 27 2026 — update ROUTER_CEREBRAS_MODEL before then
ROUTER_CEREBRAS_MODEL=llama3.1-8b
ROUTER_GROQ_MODEL=llama-3.3-70b-versatile
ROUTER_NVIDIA_MODEL=nvidia/llama-3.1-nemotron-nano-8b-v1
ROUTER_GITHUB_MODEL=microsoft/Phi-4-mini-instruct
